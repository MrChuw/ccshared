{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "authors": ["${mod_authors}"],
  "contact": {
    "sources": "${mod_repo_url}",
    "issues": "${mod_repo_url}/issues"
  },
  "description": "${mod_description}",
  "icon": "${mod_logo}",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.mrchuw.ccshared.fabric.FabricEntrypoint"]
  },
  "mixins": ["ccshared.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "${fabric_version_range}",
    "computercraft": "*"
  }
}